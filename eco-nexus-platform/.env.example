# Copy to .env and adjust. Never commit real credentials. Values below are DEVELOPMENT-ONLY.
CARBON_ENV=development
CARBON_HTTP_BIND=127.0.0.1
CARBON_HTTP_PORT=8080
CARBON_DATABASE_URL=postgresql://carbon_dev:carbon_dev_pw@localhost:5432/carbon
CARBON_DB_POOL_SIZE=8
CARBON_ALLOWED_ORIGINS=
CARBON_LOG_LEVEL=info
CARBON_MIGRATIONS_DIR=db/migrations
CARBON_AUTO_MIGRATE=false
# CARBON_REDIS_URL=redis://localhost:6379
CARBON_MAX_REQUEST_BYTES=1048576
# Static frontend served by carbon_server (same origin as the API). "none" = API only.
CARBON_FRONTEND_DIR=frontend
# Defaults: self-registration on in development, off in production
# CARBON_ALLOW_SELF_REGISTRATION=true
CARBON_SESSION_TTL_HOURS=12
CARBON_SESSION_IDLE_MINUTES=120
CARBON_ARGON2_PROFILE=interactive
# Only for the test-suite (role needs CREATEDB):
CARBON_TEST_ADMIN_URL=postgresql://carbon_dev:carbon_dev_pw@localhost:5432/postgres
